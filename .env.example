# ─────────────────────────────────────────────────────────────────────────────
# News Card Automation Platform — environment configuration
# Copy to .env and fill in. Never commit .env. Placeholders only below.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Comma-separated dashboard origins allowed to call the API when hosted separately.
CORS_ORIGIN=
# Serve the built dashboard (dist/) from the API server.
SERVE_CLIENT=false
# Express "trust proxy" setting (e.g. "1" behind one load balancer).
TRUST_PROXY=loopback

# ── Supabase (server only) ───────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service-role key: SERVER ONLY. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Dashboard authentication ─────────────────────────────────────────────────
# "supabase" (required in production) or "none" (local development only).
AUTH_MODE=supabase
# Comma-separated admin emails and/or whole domains prefixed with "@".
ADMIN_EMAILS=editor@example.com,@example.com

# ── Supabase (browser, public values only) ───────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Only set when the API is hosted on a different origin than the dashboard.
VITE_API_BASE_URL=

# ── Queue ────────────────────────────────────────────────────────────────────
MAX_BATCH_SIZE=20
QUEUE_CONCURRENCY=3
JOB_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=3000

# ── Fetching / extraction ────────────────────────────────────────────────────
FETCH_TIMEOUT_MS=15000
MAX_HTML_BYTES=3145728
MAX_IMAGE_BYTES=10485760
MAX_REDIRECTS=5
PUBLISHER_MIN_INTERVAL_MS=2000
BLOCKED_HOST_TTL_MS=1800000
USER_AGENT=Mozilla/5.0 (compatible; MUNewsCardBot/1.0; +https://mastersunion.org)
BROWSER_FALLBACK_ENABLED=true
BROWSER_TIMEOUT_MS=25000
BROWSER_MAX_PAGES=2
RSS_FALLBACK_ENABLED=true

# ── Card images: one crop per card design (2× the image box on the page) ──────
# Large = standard card, image on top, 402×196 on the page (also mirrored in news_cards.cdn_image_url)
CARD_IMAGE_WIDTH=804
CARD_IMAGE_HEIGHT=392
# Medium = feature card, text over a full-bleed image, 379×338 on the page
CARD_IMAGE_MEDIUM_WIDTH=758
CARD_IMAGE_MEDIUM_HEIGHT=676
# Small = list card, image left and text right, 244×170 on the page
CARD_IMAGE_SMALL_WIDTH=488
CARD_IMAGE_SMALL_HEIGHT=340
# cover = crop to fill the card (follows the editor's focus point when one is set);
# contain = letterbox with CARD_IMAGE_BACKGROUND
CARD_IMAGE_FIT=cover
# Automatic crop when an editor has not set one. smart (default) scores every possible frame on people/skin
# tones, detail and colour, avoids cutting through a person, and shows its exact box in the editor;
# attention is Sharp's built-in crop; centre is a plain middle crop like Figma's "Fill".
# smart | attention | entropy | centre | top | bottom | left | right
CARD_IMAGE_POSITION=smart
# webp | jpeg | png | avif
CARD_IMAGE_FORMAT=webp
CARD_IMAGE_QUALITY=82
CARD_IMAGE_BACKGROUND=#ffffff
MIN_SOURCE_IMAGE_WIDTH=200
MIN_SOURCE_IMAGE_HEIGHT=100

# ── Publisher logo ───────────────────────────────────────────────────────────
# Logos are always fetched and stored. true = also show the logo before the publisher name
# on the card (adds <img class="publisherLogo"> inside .cardHeading in the exported HTML).
CARD_SHOW_PUBLISHER_LOGO=false

# ── Card date format (e.g. "Oct 12, 2026") ───────────────────────────────────
CARD_DATE_LOCALE=en-US
CARD_DATE_MONTH=short
CARD_DATE_TIMEZONE=Asia/Kolkata

# ── Existing CDN (see README → CDN configuration) ────────────────────────────
# http = your existing CDN API · local-dev = disk storage for local testing · none = not configured
CDN_PROVIDER=none
CDN_UPLOAD_URL=
CDN_HTTP_METHOD=POST
# multipart = file upload form · raw = image bytes as request body · url-json = JSON body with image URL
CDN_UPLOAD_MODE=multipart
CDN_FILE_FIELD=file
CDN_URL_FIELD=url
# Extra static fields as JSON, e.g. {"folder":"news-cards"}
CDN_EXTRA_FIELDS=
CDN_AUTH_HEADER_NAME=Authorization
CDN_AUTH_HEADER_VALUE=
# Dot path to the public URL in the JSON response, e.g. "data.url". Use $body when the response body IS the URL.
CDN_RESPONSE_URL_PATH=url
# Returned URLs must start with this prefix, e.g. https://cdn.example.com/
CDN_PUBLIC_URL_PREFIX=
CDN_TIMEOUT_MS=30000
CDN_MAX_RETRIES=2
CDN_FILENAME_PREFIX=news-card

# local-dev CDN only
LOCAL_CDN_DIR=dev-cdn-uploads
PUBLIC_BASE_URL=http://localhost:8787
